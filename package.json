{
  "name": "bestofarr",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": ["server", "web"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web && npm run build -w server",
    "start": "npm start -w server"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
